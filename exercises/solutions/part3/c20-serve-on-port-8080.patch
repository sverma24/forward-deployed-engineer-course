From: Saurav Verma <sauravverma.genai@gmail.com>
Date: Tue, 27 Oct 2026 22:35:35 +0530
Subject: [PATCH] C20 exercise: serve on port 8080

---
 outage-desk/docker-compose.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/outage-desk/docker-compose.yml b/outage-desk/docker-compose.yml
index a128fe4..60aca15 100644
--- a/outage-desk/docker-compose.yml
+++ b/outage-desk/docker-compose.yml
@@ -6,7 +6,7 @@
 services:
   desk:
     build: { context: .., dockerfile: outage-desk/Dockerfile }
-    ports: ["8000:8000"]
+    ports: ["8080:8000"]   # port 8000 is taken on their server
     environment:
       MODEL_BACKEND: ollama
       OLLAMA_URL: http://host.docker.internal:11434
