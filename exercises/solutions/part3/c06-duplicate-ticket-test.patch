 outage-desk/tests/test_core.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/outage-desk/tests/test_core.py b/outage-desk/tests/test_core.py
index 8a4f46c..c3424c1 100644
--- a/outage-desk/tests/test_core.py
+++ b/outage-desk/tests/test_core.py
@@ -146,3 +146,13 @@ def test_eta_in_old_and_new_format():
 def test_unknown_eta_format_fails_loudly():
     with pytest.raises(ValueError):
         parse_eta({"eta": "soon"})
+
+
+# --- exercise C6 ----------------------------------------------------------
+
+def test_ticket_entered_twice_becomes_one_outage():
+    row = {"ticket_no": "S-T904", "feeder_area": "S-07", "began_at": "2026-11-03T12:00:00-05:00",
+           "restore_eta": "2026-11-03T20:30:00-05:00", "reason": "storm damage", "state": "ACTIVE", "crew_id": "CRW-14"}
+    outages, _ = clean.clean_outages([], [row, dict(row)])
+    assert len(outages) == 1
+    assert outages[0][6] == "open"
