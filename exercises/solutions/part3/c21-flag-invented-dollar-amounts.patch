From aad12d3bf79dbec37f6ea02849360e3321220d77 Mon Sep 17 00:00:00 2001
From: Saurav Verma <sauravverma.genai@gmail.com>
Date: Tue, 27 Oct 2026 22:35:29 +0530
Subject: [PATCH] C21 exercise: flag invented dollar amounts

---
 outage-desk/outage_desk/factcheck.py | 14 ++++++++++++++
 outage-desk/tests/test_core.py       | 10 ++++++++++
 2 files changed, 24 insertions(+)

diff --git a/outage-desk/outage_desk/factcheck.py b/outage-desk/outage_desk/factcheck.py
index d982001..2b194a7 100644
--- a/outage-desk/outage_desk/factcheck.py
+++ b/outage-desk/outage_desk/factcheck.py
@@ -57,6 +57,20 @@ def answer_from_data(steps):
     return None
 
 
+MONEY = re.compile(r"\$\s?(\d+(?:\.\d{2})?)")
+NUMBER = re.compile(r"\b(\d+(?:\.\d+)?)\b")
+
+
+def unknown_amounts(answer, steps):
+    """Dollar amounts in the answer that are neither in the tool data nor a simple product of numbers in it
+    (like $30 = 3 hours x $10), so a correctly worked-out credit still passes."""
+    data = " ".join(str(r["result"]) for s in steps for r in s.get("results", []))
+    nums = {float(n) for n in NUMBER.findall(data)}
+    allowed = nums | {a * b for a in nums for b in nums} | {a - b for a in nums for b in nums} \
+        | {(a - b) * c for a in nums for b in nums for c in nums if a > b and a - b < 50}
+    return [m for m in MONEY.findall(answer) if float(m) not in allowed]
+
+
 def check(answer, steps, also_allowed=()):
     """Returns (answer to show, list of times that weren't in the data).
     also_allowed: other ISO times the answer may mention, like the current time."""
diff --git a/outage-desk/tests/test_core.py b/outage-desk/tests/test_core.py
index 8a4f46c..f449979 100644
--- a/outage-desk/tests/test_core.py
+++ b/outage-desk/tests/test_core.py
@@ -146,3 +146,13 @@ def test_eta_in_old_and_new_format():
 def test_unknown_eta_format_fails_loudly():
     with pytest.raises(ValueError):
         parse_eta({"eta": "soon"})
+
+
+# --- exercise C21 ---------------------------------------------------------
+
+def test_invented_dollar_amount_is_flagged():
+    from outage_desk import factcheck
+    steps = [{"results": [{"tool": "search_policies", "result": {"results": [{"text":
+        "A credit of 10 dollars for every full hour beyond the first 12 hours, up to a maximum of 200 dollars"}]}}]}]
+    assert factcheck.unknown_amounts("A 15-hour outage earns $30.", steps + [{"results": [{"tool": "x", "result": "15"}]}]) == []
+    assert factcheck.unknown_amounts("They'll get $75.", steps) == ["75"]
