+# --- exercise C21 ---------------------------------------------------------
+
+def test_invented_dollar_amount_is_flagged():
+    from outage_desk import factcheck
+    steps = [{"results": [{"tool": "search_policies", "result": {"results": [{"text":
+        "A credit of 10 dollars for every full hour beyond the first 12 hours, up to a maximum of 200 dollars"}]}}]}]
+    question = "Does a customer get a credit after a 15-hour outage?"
+    assert factcheck.unknown_amounts("A 15-hour outage earns $30.", steps, question) == []
+    assert factcheck.unknown_amounts("They'll get $75.", steps, question) == ["75"]
