diff --git a/outage-desk/outage_desk/factcheck.py b/outage-desk/outage_desk/factcheck.py
index d982001..e7f1127 100644
--- a/outage-desk/outage_desk/factcheck.py
+++ b/outage-desk/outage_desk/factcheck.py
@@ -68,3 +68,21 @@ def check(answer, steps, also_allowed=()):
     if replacement:
         return replacement + " (Answer rebuilt from the data: the model's version had a time that isn't in any source.)", unknown
     return answer + f" WARNING: check this answer; {', '.join(unknown)} isn't in any source.", unknown
+
+
+MONEY = re.compile(r"\$\s?(\d+(?:\.\d{2})?)")
+NUMBER = re.compile(r"\b(\d+(?:\.\d+)?)\b")
+
+
+RATE = re.compile(r"\$\s?(\d+(?:\.\d+)?)|(\d+(?:\.\d+)?) dollars")
+
+
+def unknown_amounts(answer, steps, question=""):
+    """Dollar amounts in the answer that can't be found in the tool data or the question, or worked out
+    as a number of hours times a dollar rate from the data (like (15 - 12) x $10 = $30). Those were invented."""
+    text = question + " " + " ".join(str(r["result"]) for s in steps for r in s.get("results", []))
+    nums = {float(n) for n in NUMBER.findall(text)}
+    rates = {float(a or b) for a, b in RATE.findall(text)}
+    hours = nums | {a - b for a in nums for b in nums if a > b}
+    allowed = nums | {h * r for h in hours for r in rates}
+    return [m for m in MONEY.findall(answer) if float(m) not in allowed]
