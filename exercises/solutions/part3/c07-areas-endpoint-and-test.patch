From c6b0b535a4b4e878983ebf58df396afb0de7109e Mon Sep 17 00:00:00 2001
From: Saurav Verma <sauravverma.genai@gmail.com>
Date: Tue, 27 Oct 2026 22:35:20 +0530
Subject: [PATCH] C7 exercise: /areas endpoint and test

---
 outage-desk/outage_desk/db.py      |  6 ++++++
 outage-desk/outage_desk/service.py |  5 +++++
 outage-desk/tests/test_core.py     | 10 ++++++++++
 3 files changed, 21 insertions(+)

diff --git a/outage-desk/outage_desk/db.py b/outage-desk/outage_desk/db.py
index 1e950a4..a792091 100644
--- a/outage-desk/outage_desk/db.py
+++ b/outage-desk/outage_desk/db.py
@@ -52,3 +52,9 @@ def find_area(name):
         rows = db.execute("SELECT area_code, area_name, division FROM areas WHERE lower(area_name) LIKE ? "
                           "ORDER BY area_code", (f"%{name.strip().lower()}%",)).fetchall()
     return [dict(zip(("area_code", "area_name", "division"), r)) for r in rows]
+
+
+def all_areas():
+    with connect() as db:
+        rows = db.execute("SELECT area_code, area_name, division FROM areas ORDER BY area_code").fetchall()
+    return [dict(zip(("area_code", "area_name", "division"), r)) for r in rows]
diff --git a/outage-desk/outage_desk/service.py b/outage-desk/outage_desk/service.py
index 6bd7a83..890d684 100644
--- a/outage-desk/outage_desk/service.py
+++ b/outage-desk/outage_desk/service.py
@@ -40,6 +40,11 @@ def health():
             "uptime_seconds": int(time.time() - STARTED)}
 
 
+@app.get("/areas")
+def areas():
+    return db.all_areas()
+
+
 @app.get("/accounts/{account_no}")
 def account(account_no: str):
     acc = db.find_account(account_no)
diff --git a/outage-desk/tests/test_core.py b/outage-desk/tests/test_core.py
index 8a4f46c..0e02284 100644
--- a/outage-desk/tests/test_core.py
+++ b/outage-desk/tests/test_core.py
@@ -146,3 +146,13 @@ def test_eta_in_old_and_new_format():
 def test_unknown_eta_format_fails_loudly():
     with pytest.raises(ValueError):
         parse_eta({"eta": "soon"})
+
+
+# --- exercise C7 ----------------------------------------------------------
+
+def test_areas_endpoint_lists_all_twelve():
+    from fastapi.testclient import TestClient
+    from outage_desk.service import app
+    areas = TestClient(app).get("/areas").json()
+    assert len(areas) == 12
+    assert {"area_code": "S-07", "area_name": "Riverside", "division": "South"} in areas
