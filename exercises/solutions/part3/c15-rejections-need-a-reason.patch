+
+def outcome(aid):
+    """What the agent tells the customer: approved or rejected, by whom, and why."""
+    with _db() as db:
+        row = db.execute("SELECT status, decided_by, json_extract(details, '$.decision_note') "
+                         "FROM approvals WHERE id = ?", (aid,)).fetchone()
+    return dict(zip(("status", "decided_by", "note"), row)) if row else None
